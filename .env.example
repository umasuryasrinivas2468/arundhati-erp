# Shared data store (Upstash Redis). These are injected automatically into your Vercel
# project when you add the Upstash (KV) integration in Vercel → Storage. For LOCAL
# development with `vercel dev`, pull them down with:  vercel env pull .env.local
#
# The API route (api/db.js) accepts either UPSTASH_* or KV_* names.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
