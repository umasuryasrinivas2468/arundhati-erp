# Shared data store (Supabase Postgres). The serverless API route (api/db.js) reads/writes
# the ERP database as one JSON row via Supabase's REST API.
#
# These are injected automatically when you add the Supabase integration in Vercel →
# Integrations. To set them manually (or for LOCAL `vercel dev`), copy from your Supabase
# project → Settings → API, then run:  vercel env pull .env.local
#
# SUPABASE_URL                Project URL, e.g. https://xxxxxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY   The "service_role" secret key (NOT the anon key). Server-only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
